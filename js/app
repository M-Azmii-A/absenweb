// ---------- modal ----------
function tampilModal(judul, isi, opsi) {
    opsi = opsi || {};
    const host = $('#modalHost');
    host.innerHTML = `<div class="modal fade" tabindex="-1"><div class="modal-dialog ${opsi.lebar || ''}"><div class="modal-content">
        <form id="modalForm"><div class="modal-header"><h6 class="modal-title fw-bold mb-0">${judul}</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">${isi}</div>
        ${opsi.ok === false ? '' : `<div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button><button type="submit" class="btn ${opsi.danger ? 'btn-danger' : 'btn-brand'} btn-sm">${opsi.ok || 'Simpan'}</button></div>`}
        </form></div></div></div>`;
    const el = host.firstElementChild;
    const m = new bootstrap.Modal(el);
    el.addEventListener('hidden.bs.modal', () => { host.innerHTML = ''; });
    $('#modalForm', el).addEventListener('submit', async ev => {
        ev.preventDefault();
        if (!opsi.onOk) { m.hide(); return; }
        const hasil = await opsi.onOk(new FormData(ev.target));
        if (hasil !== false) m.hide();
    });
    m.show();
    return m;
}

