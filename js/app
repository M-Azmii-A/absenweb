function paramLaporan() {
    const h = new Date(); let tahun = parseInt(rutePar.tahun) || h.getFullYear(), bulan = parseInt(rutePar.bulan) || h.getMonth() + 1;
    if (bulan < 1 || bulan > 12 || tahun < 2000 || tahun > 2100) { tahun = h.getFullYear(); bulan = h.getMonth() + 1; }
    return { tahun, bulan, q: (rutePar.q || '').trim(), pid: parseInt(rutePar.pegawai_id) || null };
}
function rekapBulanan(peg, pres, tahun, bulan) {
    const akhirBulan = new Date(tahun, bulan, 0), awal = new Date(tahun, bulan - 1, 1), batas = akhirBulan < new Date() ? akhirBulan : new Date();
    const awalS = isoTgl(awal), akhirS = isoTgl(akhirBulan), tercatat = {};
    pres.filter(r => r.tanggal >= awalS && r.tanggal <= akhirS).forEach(r => tercatat[r.pegawai_id + '|' + r.tanggal] = r.status);
    const hariKerja = [];
    for (let c = new Date(awal); c <= batas; c.setDate(c.getDate() + 1)) if (dowSenin(c) < 5) hariKerja.push(isoTgl(c));
    return peg.filter(p => p.status === 'aktif').sort((a, b) => a.jenis.localeCompare(b.jenis) || a.nama.localeCompare(b.nama)).map(p => {
        const r = { hadir: 0, terlambat: 0, sakit: 0, izin: 0, alpa: 0 }, mulai = (p.created_at || '').slice(0, 10) > awalS ? p.created_at.slice(0, 10) : awalS;
        hariKerja.forEach(t => { if (t < mulai) return; const st = tercatat[p.id + '|' + t]; r[st || 'alpa']++; });
        return Object.assign({ pegawai: p }, r, { total: r.hadir + r.terlambat + r.sakit + r.izin + r.alpa });
    });
}
function filterRekap(h, q, pid) {
    if (pid) h = h.filter(r => r.pegawai.id === pid);
    if (q) { const k = q.toLowerCase(); h = h.filter(r => r.pegawai.nama.toLowerCase().includes(k) || (r.pegawai.nip || '').toLowerCase().includes(k) || kode(r.pegawai).toLowerCase().includes(k)); }
    return h;
}
function rincianHarian(p, pres, tahun, bulan) {
    const akhirBulan = new Date(tahun, bulan, 0), batas = akhirBulan < new Date() ? akhirBulan : new Date(), awalS = isoTgl(new Date(tahun, bulan - 1, 1));
    const ada = Object.fromEntries(pres.filter(r => r.pegawai_id === p.id).map(r => [r.tanggal, r]));
    const mulai = (p.created_at || '').slice(0, 10) > awalS ? p.created_at.slice(0, 10) : awalS, hasil = [];
    for (let c = new Date(tahun, bulan - 1, 1); c <= akhirBulan; c.setDate(c.getDate() + 1)) {
        const t = isoTgl(c), rec = ada[t], hari = NAMA_HARI_MULAI_SENIN[dowSenin(c)];
        if (rec) hasil.push({ tanggal: t, hari, status: rec.status, jam_masuk: rec.jam_masuk, jam_pulang: rec.jam_pulang, lokasi: rec.lokasi_masuk, keterangan: rec.keterangan });
        else if (dowSenin(c) < 5 && t >= mulai && c <= batas) hasil.push({ tanggal: t, hari, status: 'alpa' });
    }
    return hasil;
}
