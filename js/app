function mulaiJam() {
    const t = () => {
        const n = new Date(), a = $('#jamBesar'); if (!a) return;
        a.textContent = [n.getHours(), n.getMinutes(), n.getSeconds()].map(x => String(x).padStart(2, '0')).join(':');
        $('#tglBesar').textContent = `${NAMA_HARI_MULAI_MINGGU[n.getDay()]}, ${n.getDate()} ${NAMA_BULAN[n.getMonth() + 1]} ${n.getFullYear()}`;
    };
    t(); window._jamTimer = setInterval(t, 1000);
}
function setLok(teks, kartu) { const a = $('#lokTeks'), b = $('#lokKartuTeks'); if (a) a.textContent = teks; if (b) b.textContent = kartu || teks; }
function ambilLokasi() {
    K.lat = K.lng = K.alamat = null;
    if (!('geolocation' in navigator)) { setLok('Perangkat tidak mendukung lokasi', 'lokasi tidak tersedia'); $('#lokStrip').classList.add('err'); return; }
    navigator.geolocation.getCurrentPosition(pos => {
        K.lat = pos.coords.latitude; K.lng = pos.coords.longitude;
        setLok(`Lokasi terdeteksi (±${Math.round(pos.coords.accuracy)} m)`, `GPS: ${K.lat.toFixed(5)}, ${K.lng.toFixed(5)}`);
        $('#lokStrip') && $('#lokStrip').classList.remove('err');
        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${K.lat}&lon=${K.lng}&zoom=18`)
            .then(r => r.ok ? r.json() : null).then(d => { if (d && d.display_name) { K.alamat = d.display_name; setLok(K.alamat, K.alamat); } }).catch(() => {});
    }, () => { setLok('Izin lokasi ditolak', 'lokasi tidak diizinkan'); const s = $('#lokStrip'); s && s.classList.add('err'); }, { enableHighAccuracy: true, timeout: 10000 });
}
function panel(id) { $$('.panel').forEach(p => p.classList.remove('aktif')); $('#' + id).classList.add('aktif'); }
function renderPin() { $$('#pinDots .pin-dot').forEach((d, i) => d.classList.toggle('terisi', i < K.pin.length)); }
async function statusHariIni(pid) {
    const rec = (await DB.all('presensi')).find(r => r.pegawai_id === pid && r.tanggal === hariIni());
    return rec || null;
}
function jarakMeter(a1, o1, a2, o2) {
    const R = 6371000, r = x => x * Math.PI / 180, dp = r(a2 - a1), dl = r(o2 - o1);
    const a = Math.sin(dp / 2) ** 2 + Math.cos(r(a1)) * Math.cos(r(a2)) * Math.sin(dl / 2) ** 2;
    return 2 * R * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}
function batasTerlambat(jam, tol) { const [h, m] = jam.split(':').map(Number); const t = h * 60 + m + Number(tol); return t; }

function kembaliKiosk(teks, kat) { flash(teks, kat); render(); window.scrollTo(0, 0); }

function teksGeotag() {
    const n = new Date();
    const tgl = `${n.getDate()} ${NAMA_BULAN[n.getMonth() + 1]} ${n.getFullYear()} ` + [n.getHours(), n.getMinutes(), n.getSeconds()].map(x => String(x).padStart(2, '0')).join(':');
    const koor = K.lat !== null ? `${K.lat.toFixed(6)}, ${K.lng.toFixed(6)}` : 'Lokasi tidak tersedia';
    return `${K.pegawai.nama} | ${K.aksi === 'pulang' ? 'Pulang' : 'Masuk'} | ${tgl} | ${koor}`;
}
function errKamera(t) { const e = $('#kameraError'); e.textContent = t || ''; e.style.display = t ? '' : 'none'; }
function stopKamera() { if (K.stream) { K.stream.getTracks().forEach(t => t.stop()); K.stream = null; } const v = $('#kameraVideo'); if (v) v.srcObject = null; }
function bungkus(ctx, teks, lebar) {
    const baris = []; let cur = '';
    teks.split(' ').forEach(w => { const u = cur ? cur + ' ' + w : w; if (ctx.measureText(u).width > lebar && cur) { baris.push(cur); cur = w; } else cur = u; });
    if (cur) baris.push(cur); return baris;
}
function resetTampilanKamera() {
    K.foto = null; errKamera('');
    $('#kameraVideo').style.display = ''; $('#kameraHasil').style.display = 'none';
    $('#kameraInfo').style.display = ''; $('#kameraInfo').textContent = teksGeotag();
    $('#btnAmbilFoto').style.display = ''; $('#btnUlangFoto').style.display = 'none'; $('#btnKirimPresensi').style.display = 'none';
}

const AKSI = {
    logout() { Sesi.clear(); flash('Anda telah logout.', 'info'); nav('/login'); },

    // ---- kiosk ----
    async pilihPegawai(el) {
        const id = Number(el.dataset.id);
        K.pegawai = K.semua.find(p => p.id === id); K.pin = ''; renderPin();
        $('#namaTerpilih').textContent = K.pegawai.nama; $('#statusTerpilih').textContent = 'Memuat status hari ini...';
        panel('panel-pin');
        const rec = await statusHariIni(id);
        const bM = $('#btnMasuk'), bP = $('#btnPulang'); $('#btnIzin').disabled = $('#btnSakit').disabled = false;
        let ket;
        if (rec && (rec.status === 'izin' || rec.status === 'sakit')) { ket = `Hari ini tercatat ${STATUS_LABEL[rec.status]} (disetujui).`; bM.disabled = bP.disabled = true; }
        else if (rec && rec.jam_pulang) { ket = 'Sudah presensi masuk & pulang hari ini. Sampai jumpa besok!'; bM.disabled = bP.disabled = true; }
        else if (rec && rec.jam_masuk) { ket = 'Sudah presensi masuk. Silakan presensi pulang saat jam pulang.'; bM.disabled = true; bP.disabled = false; }
        else { ket = 'Belum presensi hari ini.'; bM.disabled = false; bP.disabled = true; }
