        c.width = Math.round(v.videoWidth * skala); c.height = Math.round(v.videoHeight * skala);
        const ctx = c.getContext('2d'); ctx.drawImage(v, 0, 0, c.width, c.height);
        const u = Math.max(13, Math.round(c.width / 48)), pad = Math.round(u * 0.6);
        ctx.font = `600 ${u}px Arial, sans-serif`;
        const baris = bungkus(ctx, teksGeotag(), c.width - pad * 2);
        if (K.alamat) bungkus(ctx, K.alamat, c.width - pad * 2).slice(0, 2).forEach(b => baris.push(b));
        const tinggi = baris.length * u * 1.3 + pad * 2;
        ctx.fillStyle = 'rgba(0,0,0,0.62)'; ctx.fillRect(0, c.height - tinggi, c.width, tinggi);
        ctx.fillStyle = '#fff'; ctx.textBaseline = 'top';
        baris.forEach((b, i) => ctx.fillText(b, pad, c.height - tinggi + pad + i * u * 1.3));
        K.foto = c.toDataURL('image/jpeg', 0.8);
