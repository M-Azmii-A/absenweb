document.addEventListener('change', async ev => {
    if (ev.target.id !== 'fileCadangan' || !ev.target.files[0]) return;
    try {
        const dump = JSON.parse(await ev.target.files[0].text());
        if (!STORES.every(s => Array.isArray(dump[s]))) throw new Error('Format file cadangan tidak dikenali.');
        for (const s of STORES) { await DB.clear(s); for (const o of dump[s]) await DB.put(s, o); }
        Sesi.clear(); flash('Data berhasil dipulihkan. Silakan login kembali.', 'success'); nav('/login');
    } catch (e) { alert('Gagal memulihkan: ' + e.message); }
});

