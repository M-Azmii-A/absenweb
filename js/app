        [['ID', kode(pilih)], ['Nama', pilih.nama], ['NIP', pilih.nip || '-'], ['Jabatan', `${pilih.jabatan || '-'} (${pilih.jenis === 'guru' ? 'Guru' : 'Staf'})`]].forEach(([k, v], i) => { doc.text(k, 12, y + i * 5); doc.text(': ' + v, 32, y + i * 5); });
        y += 24;
        const rinci = rincianHarian(pilih, pres, tahun, bulan);
        if (!rinci.length) { doc.text('Belum ada data kehadiran pada bulan ini.', 12, y); y += 6; }
        else {
            doc.autoTable(Object.assign({ startY: y, head: [['No', 'Tanggal', 'Hari', 'Jam Masuk', 'Jam Pulang', 'Status', 'Keterangan']],
                body: rinci.map((r, i) => [i + 1, parseTgl(r.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }), r.hari, r.jam_masuk || '-', r.jam_pulang || '-', STATUS_LABEL[r.status], r.keterangan || '']),
                columnStyles: { 0: { halign: 'center' }, 3: { halign: 'center' }, 4: { halign: 'center' }, 5: { halign: 'center' } } }, gaya));
            y = doc.lastAutoTable.finalY + 6;
            const rg = hasil.find(r => r.pegawai.id === pilih.id);
            if (rg) { doc.setFontSize(9.5); doc.setTextColor(0); doc.text(`Ringkasan: Hadir ${rg.hadir} | Terlambat ${rg.terlambat} | Sakit ${rg.sakit} | Izin ${rg.izin} | Alpa ${rg.alpa}`, 12, y); y += 4; }
        }
    } else if (!hasil.length) { doc.setTextColor(0); doc.text('Tidak ada data pegawai yang sesuai.', 12, y); y += 6; }
    else {
        doc.autoTable(Object.assign({ startY: y, head: [['No', 'ID', 'Nama', 'Jenis', 'Jabatan', 'Hadir', 'Terlambat', 'Sakit', 'Izin', 'Alpa', 'Total']],
            body: hasil.map((r, i) => [i + 1, kode(r.pegawai), r.pegawai.nama, r.pegawai.jenis === 'guru' ? 'Guru' : 'Staf', r.pegawai.jabatan || '-', r.hadir, r.terlambat, r.sakit, r.izin, r.alpa, r.total]),
            columnStyles: { 0: { halign: 'center' }, 3: { halign: 'center' }, 5: { halign: 'center' }, 6: { halign: 'center' }, 7: { halign: 'center' }, 8: { halign: 'center' }, 9: { halign: 'center' }, 10: { halign: 'center' } } }, gaya));
        y = doc.lastAutoTable.finalY + 4;
    }
    // kolom pengesahan
    if (y + 52 > 285) { doc.addPage(); y = 20; }
    y += 8; const n = new Date(), kota = set.kota || '...............', cx1 = 55, cx2 = 155;
    doc.setFontSize(9.5); doc.setTextColor(0); doc.setFont('helvetica', 'normal');
    doc.text(`${kota}, ${n.getDate()} ${NAMA_BULAN[n.getMonth() + 1]} ${n.getFullYear()}`, cx2, y, { align: 'center' });
    doc.text('Dibuat oleh,', cx1, y + 5, { align: 'center' }); doc.text('Mengesahkan,', cx2, y + 5, { align: 'center' });
    doc.text('Administrator', cx1, y + 10, { align: 'center' }); doc.text('Kepala Sekolah', cx2, y + 10, { align: 'center' });
    const yt = y + 32, nama = set.nama_kepala_sekolah || '(...........................................)';
    doc.text('(...........................................)', cx1, yt, { align: 'center' });
    doc.text(nama, cx2, yt, { align: 'center' }); doc.line(cx2 - doc.getTextWidth(nama) / 2, yt + 0.8, cx2 + doc.getTextWidth(nama) / 2, yt + 0.8);
    doc.text(set.nip_kepala_sekolah ? `NIP. ${set.nip_kepala_sekolah}` : 'NIP. .............................', cx2, yt + 5, { align: 'center' });
    doc.setFontSize(8); doc.setTextColor(150);
    doc.text(`Dicetak pada: ${n.toLocaleString('id-ID')}`, 12, yt + 14);
    doc.save(pilih ? `riwayat ${kode(pilih)} ${NAMA_BULAN[bulan].toLowerCase()} ${tahun}.pdf` : `rekap presensi ${NAMA_BULAN[bulan].toLowerCase()} ${tahun}.pdf`);
}

