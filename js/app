async function catatPresensi(pid, pin, aksi, foto) {
    const p = await DB.get('pegawai', pid);
    if (!p || p.status !== 'aktif') return kembaliKiosk('Data pegawai tidak ditemukan.', 'danger');
    if (pin !== p.pin) return kembaliKiosk('PIN salah. Silakan coba lagi.', 'danger');
    const set = await DB.pengaturan();
    const radius = Number(set.radius_meter || 0);
    if (radius > 0 && set.sekolah_lat && set.sekolah_lng) {
        if (K.lat === null) return kembaliKiosk('Lokasi tidak terdeteksi. Aktifkan izin lokasi lalu coba lagi.', 'danger');
        const j = jarakMeter(K.lat, K.lng, Number(set.sekolah_lat), Number(set.sekolah_lng));
        if (j > radius) return kembaliKiosk(`Presensi ditolak: Anda sekitar ${Math.round(j)} m dari sekolah (maks ${Math.round(radius)} m).`, 'danger');
    }
    const now = new Date(), jam = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0'), tgl = isoTgl(now);
    const lokasi = K.alamat || (K.lat !== null ? `${K.lat.toFixed(5)}, ${K.lng.toFixed(5)}` : null);
    let rec = (await DB.all('presensi')).find(r => r.pegawai_id === pid && r.tanggal === tgl);
    if (rec && (rec.status === 'izin' || rec.status === 'sakit')) return kembaliKiosk(`${p.nama} tercatat ${STATUS_LABEL[rec.status]} hari ini (izin disetujui), tidak perlu presensi.`, 'warning');

    if (aksi === 'masuk') {
        if (rec && rec.jam_masuk) return kembaliKiosk(`${p.nama} sudah presensi masuk hari ini pukul ${rec.jam_masuk}.`, 'warning');
        const status = (now.getHours() * 60 + now.getMinutes()) <= batasTerlambat(set.jam_masuk_standar, set.toleransi_menit) ? 'hadir' : 'terlambat';
        rec = Object.assign(rec || { pegawai_id: pid, tanggal: tgl }, { jam_masuk: jam, lokasi_masuk: lokasi, lat_masuk: K.lat, lng_masuk: K.lng, foto_masuk: foto, status, waktu_catat: nowStr() });
        await DB.put('presensi', rec);
        return kembaliKiosk(`Presensi Masuk berhasil, ${p.nama} — pukul ${jam} (${status === 'terlambat' ? 'Terlambat' : 'Tepat Waktu'}).`, status === 'terlambat' ? 'warning' : 'success');
    }
    if (aksi === 'pulang') {
        if (!rec || !rec.jam_masuk) return kembaliKiosk(`${p.nama} belum presensi masuk, belum bisa presensi pulang.`, 'danger');
        if (rec.jam_pulang) return kembaliKiosk(`${p.nama} sudah presensi pulang hari ini pukul ${rec.jam_pulang}.`, 'warning');
        Object.assign(rec, { jam_pulang: jam, lokasi_pulang: lokasi, lat_pulang: K.lat, lng_pulang: K.lng, foto_pulang: foto });
        await DB.put('presensi', rec);
        return kembaliKiosk(`Presensi Pulang berhasil, ${p.nama} — pukul ${jam}. Sampai jumpa!`, 'success');
    }
    kembaliKiosk('Aksi tidak dikenali.', 'danger');
}

async function ajukanIzin(pid, pin, jenis, mulai, selesai, alasan) {
    const p = await DB.get('pegawai', pid);
    if (!p || p.status !== 'aktif') return kembaliKiosk('Data pegawai tidak ditemukan.', 'danger');
    if (pin !== p.pin) return kembaliKiosk('PIN salah. Pengajuan tidak dikirim.', 'danger');
    const dm = parseTgl(mulai), ds = parseTgl(selesai), t0 = parseTgl(hariIni());
    if (dm < new Date(t0.getTime() - 7 * 864e5)) return kembaliKiosk('Tanggal mulai tidak boleh lebih dari 7 hari yang lalu.', 'danger');
    if ((ds - dm) / 864e5 > 30) return kembaliKiosk('Rentang pengajuan maksimal 31 hari.', 'danger');
    const tabrakan = (await DB.all('perizinan')).some(z => z.pegawai_id === pid && ['menunggu', 'disetujui'].includes(z.status) && z.tanggal_mulai <= selesai && z.tanggal_selesai >= mulai);
    if (tabrakan) return kembaliKiosk('Sudah ada pengajuan (menunggu/disetujui) pada rentang tanggal tersebut.', 'warning');
    await DB.put('perizinan', { pegawai_id: pid, jenis, tanggal_mulai: mulai, tanggal_selesai: selesai, alasan, status: 'menunggu', diajukan_pada: nowStr() });
    kembaliKiosk(`Pengajuan ${STATUS_LABEL[jenis]} atas nama ${p.nama} terkirim dan menunggu persetujuan Kepala Sekolah.`, 'success');
}

async function putuskanIzin(id, keputusan, catatan) {
    const z = await DB.get('perizinan', id);
    if (!z || z.status !== 'menunggu') { flash('Pengajuan ini sudah diputuskan sebelumnya.', 'warning'); return render(); }
    z.status = keputusan === 'setuju' ? 'disetujui' : 'ditolak';
    z.diputuskan_oleh = Sesi.get().nama; z.diputuskan_pada = nowStr(); z.catatan_keputusan = catatan;
    await DB.put('perizinan', z);
    let pesan = `Pengajuan ${z.status}.`;
    if (z.status === 'disetujui') pesan += ` ${await terapkanPerizinan(z)} hari kerja dicatat ke presensi.`;
    flash(pesan, z.status === 'disetujui' ? 'success' : 'warning'); render();
}
async function terapkanPerizinan(z) {
    const semua = await DB.all('presensi'); let n = 0;
    for (let cur = parseTgl(z.tanggal_mulai), akhir = parseTgl(z.tanggal_selesai); cur <= akhir; cur.setDate(cur.getDate() + 1)) {
        if (dowSenin(cur) >= 5) continue;
        const tgl = isoTgl(cur), rec = semua.find(r => r.pegawai_id === z.pegawai_id && r.tanggal === tgl);
        if (rec && rec.jam_masuk) continue;
        await DB.put('presensi', Object.assign(rec || { pegawai_id: z.pegawai_id, tanggal: tgl }, { status: z.jenis, keterangan: z.alasan, waktu_catat: nowStr() }));
        n++;
    }
    return n;
}

