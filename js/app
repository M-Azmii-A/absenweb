    '/akun': { judul: 'Kelola Akun', ikon: 'person-gear', fn: halAkun, admin: true }
};
let rutePar = {};

function parseHash() {
    const h = location.hash.replace(/^#/, '') || '/';
    const [path, qs] = h.split('?');
    rutePar = Object.fromEntries(new URLSearchParams(qs || ''));
    return path || '/';
}
function nav(path, par) {
    const qs = par ? '?' + new URLSearchParams(Object.entries(par).filter(([, v]) => v !== '' && v != null)).toString() : '';
    const baru = '#' + path + (qs === '?' ? '' : qs);
    if (location.hash === baru) render(); else location.hash = baru;
}

function bersihkanModal() {
    $('#modalHost').innerHTML = '';
    $$('.modal-backdrop').forEach(e => e.remove());
    document.body.classList.remove('modal-open'); document.body.style.overflow = ''; document.body.style.paddingRight = '';
}

async function render() {
    bersihkanModal();
    stopKamera();
    clearInterval(window._jamTimer);
    const path = parseHash();
    document.body.classList.toggle('kiosk', path === '/');
    const app = $('#app');
    try {
        if (path === '/') return await halKiosk(app);
        if (path === '/login') return halLogin(app);
        const s = Sesi.get();
        if (!s) { flash('Silakan login terlebih dahulu.', 'warning'); return nav('/login'); }
        const r = RUTE_ADMIN[path];
        if (!r) return nav('/admin');
        if (r.admin && s.role !== 'admin') { flash('Halaman ini hanya dapat diakses oleh Administrator.', 'danger'); return nav('/admin'); }
        const konten = await r.fn();
        const izinMenunggu = (await DB.all('perizinan')).filter(z => z.status === 'menunggu').length;
        app.innerHTML = layoutAdmin(path, konten, s, izinMenunggu);
        pasangLayout();
    } catch (e) {
        console.error(e);
        app.innerHTML = `<div class="page-wrap"><div class="alert alert-danger">Terjadi kesalahan: ${esc(e.message)}</div></div>`;
    }
}

