    get() { try { return JSON.parse(sessionStorage.getItem('sesi') || 'null'); } catch (e) { return null; } },
    set(o) { sessionStorage.setItem('sesi', JSON.stringify(o)); },
    clear() { sessionStorage.removeItem('sesi'); }
};
let pesanTertunda = [];
function flash(teks, kat) { pesanTertunda.push({ teks, kat: kat || 'info' }); }
function htmlFlash(dismiss) {
